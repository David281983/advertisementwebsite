{% if advertisement.images is empty %}
  <div class="w-full h-96 bg-gray-200 dark:bg-gray-700 rounded-2xl"></div>
{% else %}
  <div class="flex gap-2 h-96">
    <div class="flex-1 min-w-0">
    <a href="{{ ads ~ advertisement.images.first.filename }}" target="_blank" class="block w-full h-full">
    <img src="{{ ads ~ advertisement.images.first.filename }}"
            class="w-full h-full object-cover rounded-l-2xl" />
    </a>
</div>

    {% if advertisement.images|length > 1 %}
      <div class="w-1/3 flex flex-col gap-2">
        {% for image in advertisement.images|slice(1, 2) %}
        <a href="{{ ads ~ image.filename }}" target="_blank" class="block flex-1 min-h-0">
          <img src="{{ ads ~ image.filename }}"
         class="w-full h-full object-cover {{ loop.first ? 'rounded-tr-2xl' }} {{ loop.last ? 'rounded-br-2xl' }}" />
        </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% if advertisement.images|length > 3 %}
    <div class="grid grid-cols-4 gap-2 mt-2">
      {% for image in advertisement.images|slice(3) %}
      
        <a href="{{ ads ~ image.filename }}" target="_blank">
            <img src="{{ ads ~ image.filename }}" class="w-full h-32 object-cover rounded-lg" />
        </a>
        
      {% endfor %}
    </div>
  {% endif %}
{% endif %}
<div class="bg-white dark:bg-gray-700 rounded-xl p-5 shadow-[2px_2px_15px_0px_#00000026]">
    <div class="flex items-center gap-3 mb-4">
        <a href="{{ path('app_profile', {id: advertisement.author.id}) }}">
        {{ include('shared/_avatar.html.twig', { profile: advertisement.author.userProfile, size: 16 }) }}</a>
        <div class="min-w-0">
            <a href="{{ path('app_profile', {id: advertisement.author.id}) }}"
               class="font-bold hover:underline block truncate">
                {{ advertisement.author.userProfile.name ?? advertisement.author.email }}
            </a>
            {% if advertisement.author.userProfile and advertisement.author.userProfile.address %}
                <div class="text-sm text-gray-500 dark:text-gray-400 truncate">
                    {{ advertisement.author.userProfile.address }}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="space-y-2">
        {% if advertisement.author.userProfile and advertisement.author.userProfile.phoneNumber %}
            <a href="tel:{{ advertisement.author.userProfile.phoneNumber }}"
               class="flex items-center justify-center gap-2 w-full bg-indigo-600 hover:bg-indigo-700 text-white rounded-md py-2 text-sm">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                </svg>
                {{ advertisement.author.userProfile.phoneNumber }}
            </a>
        {% endif %}

        <a href="mailto:{{ advertisement.author.email }}"
           class="flex items-center justify-center gap-2 w-full bg-indigo-600 hover:bg-indigo-700 text-white rounded-md py-2 text-sm">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
            </svg>
            Send email
        </a>
    </div>
</div>